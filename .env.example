# Адрес проекта Supabase и анонимный ключ — их видно в браузере, это нормально:
# доступ к чужим данным закрыт политиками Row Level Security.
VITE_SUPABASE_URL=https://ваш-проект.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Только для скриптов копии и восстановления (никогда не попадает в браузер):
SUPABASE_URL=https://ваш-проект.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Нужен, только если восстанавливаем на пустой проект без таблиц:
# SUPABASE_DB_URL=postgresql://postgres:пароль@db.ваш-проект.supabase.co:5432/postgres
